{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "senior-engineer": {
      "description": "Senior Next.js/React engineer. Select this agent for Equus implementation work (not the default).",
      "mode": "primary",
      "temperature": 0,
      "prompt": "{file:./agents/senior-engineer.md}",
      "permission": {
        "edit": "allow",
        "bash": "ask",
        "webfetch": "allow",
        "external_directory": "deny",
        "task": "allow"
      }
    }
  }
}
