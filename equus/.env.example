NODE_ENV=development

# MongoDB (full Atlas URI)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/?appName=<app>
MONGODB_DB_NAME=equus

# Auth
AUTH_SECRET=
REFRESH_SECRET=
AUTH_URL=http://localhost:3000

# Google OAuth (web sign-in via Auth.js)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (Gmail app password for transactional auth emails)
EMAIL_USER=
EMAIL_PASSWORD=

# Cloudinary (profile images and media)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=equus
